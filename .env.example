# Variables de entorno (sección 14). Valores de desarrollo y dobles de 0.1: NO usar en producción.
# En Coolify, los secretos salen de las variables mágicas SERVICE_PASSWORD_* (docker-compose.coolify.yml).
APP_ENV=development
APP_NAME=Producto Demo
DEFAULT_LOCALE=es
DISPLAY_TZ=Europe/Madrid
LOG_LEVEL=INFO

PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_UPLOAD_URL=http://localhost:8080/files/
PUBLIC_FILES_URL=http://localhost:8090

DATABASE_URL=postgresql+psycopg://conversor:conversor@postgres:5432/conversor
VALKEY_URL=redis://valkey:6379/0
AUTH_JWKS_URL=http://web:3000/api/auth/jwks
BETTER_AUTH_URL=http://localhost:3000

# Secretos de desarrollo (en producción: SERVICE_PASSWORD_64_FILES, _ANON y _JOBSECRETS).
FILE_TOKEN_SECRET=desarrollo-descargas-cambiar
ANON_TOKEN_SECRET=desarrollo-anonimos-cambiar
JOB_SECRETS_KEY=desarrollo-secretos-de-trabajos

FILESTORE_PATH=/srv/files
DISK_MAX_USAGE_PERCENT=85
DISK_MIN_FREE_GB=2
DISK_RESERVE_FACTOR=3
QUEUE_MAX_WAIT_SECONDS_PDF=120
CLIENT_MAX_MB=100
FILE_TTL_ANON_MINUTES=60
FILE_TTL_USER_HOURS=24
SHARE_MAX_DAYS=7
UPLOAD_MAX_BYTES=1073741824
UPLOAD_CHUNK_BYTES=52428800
DOWNLOAD_TOKEN_MINUTES=15

BACKUP_PATH=/srv/backups
BACKUP_RETENTION_DAYS=14
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=

ADMIN_EMAILS=admin@ejemplo.test
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-responder@ejemplo.test
MAIL_SHARE_DAILY_LIMIT=10
# solicitar-firmas: solicitudes por cuenta Pro y día (con cuenta gratuita, 3).
SIGN_REQUEST_DAILY_LIMIT=20

# Claves de prueba oficiales de Cloudflare Turnstile (siempre pasan).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TRUST_CF_CONNECTING_IP=false
RATE_LIMIT_PER_MINUTE=60
ANON_TOKENS_PER_IP_DAY=10

# Pagos: FakePaymentProvider en desarrollo y CI; Stripe en modo test cuando el propietario aporte las claves.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GDRIVE_ENABLED=false
DROPBOX_ENABLED=false
# Claves públicas del navegador para Google Drive (Picker, ámbito drive.file) y Dropbox (Chooser y Saver); solo las usa la web.
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
DROPBOX_APP_KEY=

IMAGE_MAX_PIXELS=100000000
RENDER_MAX_PIXELS=50000000
OCR_MAX_LANGUAGES=3
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_WEB_URL=http://gotenbergweb:3000
EGRESS_WEB_URL=http://egressweb:4750

HEVC_DECODE_ENABLED=false
# quitar-fondo (6.4): u2net (pesos Apache-2.0) por defecto; isnet-general-use solo tras revisar su licencia (D-96).
# Nunca bria-rmbg. El modelo se descarga al construir la imagen worker-media con el mismo nombre.
REMBG_MODEL=u2net
# Transcripción (6.4): faster-whisper en CPU. El modelo tiene que estar en la imagen worker-av (argumento de construcción
# WHISPER_MODELS="small", o "small medium" para la precisión alta): los workers no descargan nada.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Voz de pdf-a-audio (6.4 y 14): Kokoro-82M en la imagen worker-av, con fonemas de espeak-ng. Voces que trae la imagen:
# ef_dora, em_alex y em_santa (español) y af_heart, af_bella y am_michael (inglés de EE. UU.). Un idioma sin voz está
# apagado: TTS_VOICE_ES se queda vacía hasta que el propietario escuche la voz española (docs/DEPLOY-CHECKLIST.md).
TTS_ENGINE=kokoro
TTS_VOICE_ES=
TTS_VOICE_EN=af_heart

# Firma (10 y 14, F4). Sello de la plataforma por PKCS#11 (SoftHSM2): solo workersign conoce el PIN y monta el token.
# SIGN_CERT_PATH es la cadena del sello en PEM y TSA_URL la TSA RFC 3161 que elija el propietario (0.1).
SIGN_PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
SIGN_PKCS11_TOKEN_LABEL=conversor-sello
SIGN_PKCS11_KEY_LABEL=sello
SIGN_PKCS11_PIN=
SIGN_CERT_PATH=
TSA_URL=
SEAL_ENABLED=true
SEAL_DAILY_LIMIT=500
SEAL_ACCOUNT_DAILY_LIMIT=20
# Raíces de la TSA en PEM (archivo o la propia variable); vacía: las que devuelve la TSA.
TSA_TRUST_ROOTS=
# Lista de confianza de la UE para verificar firmas (7.23): la descarga workersignverify por egressweb.
EUTL_LOTL_URL=https://ec.europa.eu/tools/lotl/eu-lotl.xml
EUTL_REFRESH_HOURS=24
# Raíces propias que la verificación acepta además de la lista de la UE (la cadena del sello, en PEM).
SIGN_VERIFY_EXTRA_ROOTS=
INVOICING_ES_ENABLED=false
VIDEO_H264_ENCODING_ENABLED=false
WORKER_RUNTIME=runc
# IA (6 y 14). OPENROUTER_API_KEY solo en workerai (12.1); sin clave y con APP_ENV=development se usa el proveedor falso
# determinista. Todas las peticiones llevan provider.data_collection="deny" y solo se usan modelos de precio 0.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PREFERRED_MODELS=
LLM_FALLBACK_ROUTER=openrouter/free
LLM_MODELS_REFRESH_HOURS=6
AI_DAILY_BUDGET=950
AI_PRO_RESERVE=400
AI_RPM_LIMIT=18
AI_BUDGET_RESET_TZ=UTC
AI_REQUIRE_CONSENT=true
AI_CHAT_RPM_SHARE=0.5
AI_TASK_MAX_REQUESTS=20
EGRESS_AI_URL=http://egressai:4750
# chat-pdf (6.4): embeddings locales; el modelo va dentro de la imagen worker-ai (infra/embeddings/fetch-model.sh).
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_HOME=/opt/models/embeddings
