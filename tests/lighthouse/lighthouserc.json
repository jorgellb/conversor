{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3100/es",
        "http://127.0.0.1:3100/es/comprimir-pdf",
        "http://127.0.0.1:3100/es/pdf-a-word",
        "http://127.0.0.1:3100/es/resumir-pdf",
        "http://127.0.0.1:3100/es/word-a-pdf-accesible",
        "http://127.0.0.1:3100/es/ogg-a-mp3",
        "http://127.0.0.1:3100/en/compress-pdf"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/informes"
    }
  }
}
