<?xml version="1.0" encoding="UTF-8"?>
<!-- Escenarios propios de KoSIT (7.23 y D-191): perfiles de Factur-X (y sus equivalentes de ZUGFeRD 2.0, `urn:zugferd.de:2p0:*`) con el XSD y el Schematron oficiales 1.09 que
     redistribuye factur-x (BSD), y una reserva EN 16931 para UBL y CII con una CIUS sin configuración pública (solo las
     reglas EN 16931 de la Comisión, que trae la configuración de XRechnung). KoSIT no elige ningún escenario si coincide
     más de uno, así que la reserva excluye las CIUS que ya tienen el suyo (XRechnung, Peppol y Factur-X) y el EN 16931
     puro, que está en la configuración de XRechnung. Rutas relativas a /opt/kosit. -->
<scenarios xmlns="http://www.xoev.de/de/validator/framework/1/scenarios" frameworkVersion="1.0.0">
  <name>Conversor: Factur-X y EN16931 con otra CIUS</name>
  <author>Conversor</author>
  <date>2026-11-19</date>
  <description><p>Escenarios propios del portal (D-191).</p></description>
  <scenario>
    <name>Factur-X MINIMUM (CII)</name>
    <description><p>Factur-X MINIMUM (CII)</p></description>
    <namespace prefix="rsm">urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100</namespace>
    <namespace prefix="ram">urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/rsm:CrossIndustryInvoice[(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text() = 'urn:factur-x.eu:1p0:minimum' or rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text() = 'urn:zugferd.de:2p0:minimum')])</match>
    <validateWithXmlSchema><resource><name>XSD Factur-X MINIMUM (CII)</name><location>facturx/facturx-minimum/Factur-X_MINIMUM.xsd</location></resource></validateWithXmlSchema>
    <validateWithSchematron><resource><name>Schematron Factur-X MINIMUM (CII)</name><location>facturx/facturx-minimum/Factur-X_1.09_MINIMUM.xsl</location></resource></validateWithSchematron>
    <createReport><resource><name>Informe</name><location>xrechnung/resources/xrechnung-report.xsl</location></resource></createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
