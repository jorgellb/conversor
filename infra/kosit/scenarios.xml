  <scenario>
    <name>EN16931 con otra CIUS (CII)</name>
    <description><p>EN16931 con otra CIUS (CII)</p></description>
    <namespace prefix="rsm">urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100</namespace>
    <namespace prefix="ram">urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/rsm:CrossIndustryInvoice[starts-with(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text(), 'urn:cen.eu:en16931:2017#') and not(contains(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text(), 'xeinkauf.de')) and not(contains(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text(), 'peppol.eu')) and not(contains(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text(), 'factur-x.eu')) and not(contains(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text(), 'zugferd.de'))])</match>
    <validateWithXmlSchema><resource><name>XSD EN16931 con otra CIUS (CII)</name><location>xrechnung/resources/cii/16b/xsd/CrossIndustryInvoice_100pD16B.xsd</location></resource></validateWithXmlSchema>
    <validateWithSchematron><resource><name>Schematron EN16931 con otra CIUS (CII)</name><location>xrechnung/resources/cii/16b/xsl/EN16931-CII-validation.xsl</location></resource></validateWithSchematron>
