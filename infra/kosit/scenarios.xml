    <match>exists(/rsm:CrossIndustryInvoice[(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text() = 'urn:factur-x.eu:1p0:basicwl' or rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text() = 'urn:zugferd.de:2p0:basicwl')])</match>
    <validateWithXmlSchema><resource><name>XSD Factur-X BASIC WL (CII)</name><location>facturx/facturx-basicwl/Factur-X_BASICWL.xsd</location></resource></validateWithXmlSchema>
